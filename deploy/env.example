# BeanWEB 环境变量模板 —— install.sh 自动复制为仓库根 .env（已 gitignore，权限 600）
#
# 改完 .env 后重跑 bash deploy/install.sh 生效。
# AUTH_ENABLED=false：以下配置全部无效，应用无鉴权（本地/初次部署形态）
# AUTH_ENABLED=true：按 AUTH_MODE 校验必填项，缺失或非法则启动失败（fail-fast）

AUTH_ENABLED=false

# ===== AUTH_MODE=password（默认）：本地密码登录，无外部依赖 =====
# 密码哈希（不是明文）生成：cd backend && ../.venv/bin/python scripts/hash_password.py
#AUTH_PASSWORD_HASH=

# ===== AUTH_MODE=oidc：接入 Burrow SSO（需已部署 Burrow 并注册应用）=====
#AUTH_MODE=oidc
#OIDC_ISSUER=https://sso.example.com
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_REDIRECT_URI=https://beanweb.example.com/api/auth/callback
#AUTH_ALLOWED_SUB=

# ===== 两种模式共需 =====
#AUTH_SECRET_KEY=           # 会话签名密钥，生成：openssl rand -base64 32

# ===== 可选项（一般不需要改） =====
#AUTH_SESSION_MAX_AGE=43200  # 会话绝对超时（秒），默认 12h
#AUTH_REQUEST_TTL=600        # oidc：登录请求有效期（秒）
#COOKIE_SECURE=auto          # auto|true|false
